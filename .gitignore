# Secrets: never commit the private key file.
# `.env.*` covers the usual `.env.local` / `.env.production` variants, which
# a bare `.env` pattern would silently let through. The template stays tracked
# so the expected variable names remain documented.
.env
.env.*
!.env.example

# Runtime output
logs/
*.jsonl

# Backtest artifacts
backtest_cache/
snapshots/

# Research data store (datalake). Holds archived and forward-collected market
# data measured in gigabytes, none of which is reproducible from the repo and
# none of which belongs in git history. The `datalake/` package that reads and
# writes it IS tracked - only the data is ignored.
data/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store

# Local IDE / agent state, deliberately kept out of the repository. It holds
# per-machine automation state rather than anything the project needs to build
# or run, and committing it would mean every machine fighting over one copy.
.codebuddy/

# Copy to .env and fill in. NEVER commit .env.

# ---------------------------------------------------------------------------
# Hyperliquid API wallet private key.
#
# Create this at https://app.hyperliquid.xyz/API
# Use an API WALLET key, NOT your main wallet key. An API wallet can trade on
# behalf of your account but cannot withdraw funds. Treat it as still
# sensitive: anyone holding it can open and close positions on your account.
#
# Required only for live trading (--live). The default dry-run mode does not
# read this variable, and every read-only data endpoint is public.
# ---------------------------------------------------------------------------
HYPERLIQUID_PRIVATE_KEY=

# The account the API wallet acts for. Optional: defaults to the API wallet
# address, which is correct when the API wallet was created for that account.
HYPERLIQUID_ACCOUNT_ADDRESS=

# ---------------------------------------------------------------------------
# Dry-run account equity, in USD. Used only to size simulated positions so the
# numbers in the journal resemble a real run. Live mode reads the real value.
# ---------------------------------------------------------------------------
DRY_RUN_EQUITY_USD=1000

# ---------------------------------------------------------------------------
# Optional: curated smart money feed instead of the public leaderboard.
# Enable `use_hyperfeed: true` in the config after setting this.
# ---------------------------------------------------------------------------
SENPI_API_KEY=
SENPI_BASE_URL=https://api.senpi.ai
